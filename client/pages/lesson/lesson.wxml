<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap"><text>加载中...</text></view>
  <view wx:elif="{{lesson}}" class="content">
    <view class="lesson-header"><text class="lesson-title">{{lesson.title}}</text><text class="duration">⏱ {{lesson.duration || 5}}分钟</text></view>
    <view class="lesson-body"><rich-text nodes="{{lesson.content}}" /></view>
    <view class="actions">
      <button class="btn-primary" bindtap="doComplete">✅ 完成学习</button>
      <button class="btn-outline" bindtap="goQuiz">📝 去答题</button>
    </view>
  </view>
</view>