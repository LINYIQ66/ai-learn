.page{min-height:100vh;background:#fff}.loading-wrap{text-align:center;padding:80rpx;color:#999}.content{padding:30rpx}.lesson-header{margin-bottom:40rpx;padding-bottom:30rpx;border-bottom:1rpx solid #f0f0f0}.lesson-title{font-size:38rpx;font-weight:700;display:block;margin-bottom:12rpx}.duration{font-size:24rpx;color:#999}.lesson-body{font-size:30rpx;line-height:1.8;color:#333}.actions{margin-top:60rpx;display:flex;flex-direction:column;gap:20rpx}.btn-primary{background:linear-gradient(135deg,#4F46E5,#7C3AED);color:#fff;border-radius:14rpx;padding:24rpx;font-size:30rpx;text-align:center;border:none}.btn-primary::after{border:none}.btn-outline{background:#fff;color:#4F46E5;border:2rpx solid #4F46E5;border-radius:14rpx;padding:24rpx;font-size:30rpx;text-align:center}.btn-outline::after{border:none}