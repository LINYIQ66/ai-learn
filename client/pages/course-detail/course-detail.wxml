<!--pages/course-detail/course-detail.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text>加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="empty-state">
    <text class="icon">😵</text>
    <text class="text">{{error}}</text>
  </view>

  <!-- 课程内容 -->
  <block wx:else>
    <!-- 课程头部 -->
    <view class="course-header card">
      <view class="header-top">
        <image wx:if="{{course.cover_image}}" class="cover-img" src="{{course.cover_image}}" mode="aspectFill" />
        <view wx:else class="cover-placeholder">📚</view>
        <view class="header-info">
          <text class="course-title">{{course.title}}</text>
          <view class="header-meta">
            <text class="tag tag-beginner" wx:if="{{course.category}}">{{course.category}}</text>
            <text class="lesson-count">{{totalCount}} 课时</text>
          </view>
        </view>
      </view>
      <text class="course-desc" wx:if="{{course.description}}">{{course.description}}</text>

      <!-- 整体进度 -->
      <view class="overall-progress">
        <view class="progress-header">
          <text class="progress-label">学习进度</text>
          <text class="progress-text">{{completedCount}}/{{totalCount}} 已完成</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progressPercent}}%"></view>
        </view>
      </view>
    </view>

    <!-- 课程列表 -->
    <view class="lesson-section">
      <view class="section-title">📖 课程目录</view>

      <view
        wx:for="{{lessons}}"
        wx:key="id"
        class="lesson-item {{item.completed ? 'lesson-completed' : ''}}"
        data-lesson-id="{{item.id}}"
        data-course-id="{{course.id}}"
        bindtap="goLesson"
      >
        <view class="lesson-number {{item.completed ? 'number-done' : ''}}">
          <text wx:if="{{item.completed}}">✅</text>
          <text wx:else>{{index + 1}}</text>
        </view>

        <view class="lesson-body">
          <view class="lesson-title-row">
            <text class="lesson-title">{{item.title}}</text>
            <text class="lesson-duration" wx:if="{{item.duration}}">{{item.duration}}</text>
          </view>
          <text class="lesson-summary" wx:if="{{item.summary}}">{{item.summary}}</text>

          <view class="lesson-footer">
            <text wx:if="{{item.completed}}" class="lesson-score">
              得分：<text class="score-value">{{item.score || '-'}}</text>
            </text>
            <text wx:else class="lesson-pending">待学习</text>
          </view>
        </view>

        <view class="lesson-arrow">›</view>
      </view>

      <!-- 空课程列表 -->
      <view wx:if="{{lessons.length === 0}}" class="empty-state">
        <text class="icon">📭</text>
        <text class="text">暂无课程内容</text>
      </view>
    </view>
  </block>
</view>
