/* pages/course-detail/course-detail.wxss */

/* ========== 课程头部 ========== */
.course-header {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 40rpx 30rpx;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  color: #fff;
}

.header-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.cover-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: rgba(255,255,255,0.2);
}

.cover-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.header-info {
  flex: 1;
  min-width: 0;
}

.course-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.header-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-meta .tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.25);
  color: #fff;
}

.lesson-count {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.course-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.7;
  display: block;
  margin-bottom: 24rpx;
}

/* ========== 整体进度 ========== */
.overall-progress {
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.progress-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.progress-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
}

.progress-bar {
  height: 10rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #FFD700;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

/* ========== 课程目录 ========== */
.lesson-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* ========== 课时条目 ========== */
.lesson-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 28rpx 24rpx;
  margin-bottom: 2rpx;
  transition: background 0.2s;
}

/* 交替背景 */
.lesson-item:nth-child(even) {
  background: #FAFAFC;
}

.lesson-item:first-child {
  border-radius: 16rpx 16rpx 0 0;
}

.lesson-item:last-child {
  border-radius: 0 0 16rpx 16rpx;
  margin-bottom: 0;
}

.lesson-item:only-child {
  border-radius: 16rpx;
}

.lesson-item:active {
  background: #F0EEFF;
}

.lesson-completed {
  opacity: 0.75;
}

.lesson-completed .lesson-title {
  color: #666;
}

/* 序号 / 勾选 */
.lesson-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #4F46E5;
  background: #EEF2FF;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.number-done {
  background: #D1FAE5;
  font-size: 28rpx;
}

/* 主体内容 */
.lesson-body {
  flex: 1;
  min-width: 0;
}

.lesson-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.lesson-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.lesson-duration {
  font-size: 22rpx;
  color: #999;
  background: #F5F5F7;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.lesson-summary {
  font-size: 24rpx;
  color: #999;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.lesson-footer {
  display: flex;
  align-items: center;
}

.lesson-score {
  font-size: 24rpx;
  color: #10B981;
}

.score-value {
  font-weight: 700;
  color: #059669;
}

.lesson-pending {
  font-size: 22rpx;
  color: #ccc;
}

/* 箭头 */
.lesson-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
  flex-shrink: 0;
}
