.header{background:linear-gradient(135deg,#4F46E5,#7C3AED);padding:60rpx 30rpx 50rpx;display:flex;flex-direction:column;align-items:center;gap:16rpx}.avatar-lg{width:120rpx;height:120rpx;border-radius:50%;border:4rpx solid rgba(255,255,255,.5);background:rgba(255,255,255,.2)}.name{font-size:36rpx;font-weight:700;color:#fff}.level{background:rgba(255,255,255,.25);color:#FFD700;padding:6rpx 24rpx;border-radius:20rpx;font-size:24rpx}.stats{display:flex;background:#fff;margin:-30rpx 30rpx 24rpx;border-radius:20rpx;padding:30rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.06)}.stat-item{flex:1;text-align:center}.stat-num{display:block;font-size:36rpx;font-weight:700;color:#1a1a2e}.stat-label{font-size:22rpx;color:#999;margin-top:6rpx}.menu{background:#fff;margin:0 30rpx;border-radius:20rpx;overflow:hidden}.menu-item{display:flex;justify-content:space-between;padding:32rpx 30rpx;font-size:28rpx;border-bottom:1rpx solid #F5F5F7}.menu-item:last-child{border-bottom:none}