<view class="page">
  <view class="header">
    <image class="avatar-lg" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    <text class="name">{{userInfo.nickname || '微信用户'}}</text>
    <text class="level">Lv.{{level || 1}}</text>
  </view>
  <view class="stats">
    <view class="stat-item"><text class="stat-num">{{points || 0}}</text><text class="stat-label">积分</text></view>
    <view class="stat-item"><text class="stat-num">{{streakDays || 0}}</text><text class="stat-label">连续天数</text></view>
    <view class="stat-item"><text class="stat-num">{{level || 1}}</text><text class="stat-label">等级</text></view>
  </view>
  <view class="menu">
    <view class="menu-item" bindtap="goPoints"><text>💰 积分明细</text><text>→</text></view>
    <view class="menu-item" bindtap="goRewards"><text>🎁 积分商城</text><text>→</text></view>
    <view class="menu-item" bindtap="goInvitations"><text>👥 学习小组</text><text>→</text></view>
    <view class="menu-item" bindtap="goMessages"><text>💬 消息中心</text><text>→</text></view>
  </view>
</view>