.page{min-height:100vh;background:#F5F5F7}.tabs{display:flex;background:#fff;padding:20rpx 30rpx;gap:20rpx;position:sticky;top:0;z-index:10}.tab{padding:12rpx 32rpx;border-radius:30rpx;font-size:26rpx;background:#F5F5F7;color:#666}.tab.active{background:#4F46E5;color:#fff}.rank-list{padding:20rpx 30rpx}.rank-item{display:flex;align-items:center;gap:20rpx;background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}.rank-num{width:60rpx;text-align:center;font-size:32rpx;font-weight:700}.rank-avatar{width:80rpx;height:80rpx;border-radius:50%;background:#f0f0f0}.rank-info{flex:1}.rank-name{font-size:28rpx;font-weight:600;display:block}.rank-level{font-size:22rpx;color:#999}.rank-points{font-size:28rpx;font-weight:700;color:#4F46E5}.loading-wrap{text-align:center;padding:80rpx;color:#999}.empty-state{text-align:center;padding:80rpx;color:#999}