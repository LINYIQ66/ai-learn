.page{min-height:100vh;background:#fff}.log-item{display:flex;justify-content:space-between;align-items:center;padding:28rpx 30rpx;border-bottom:1rpx solid #f5f5f7}.log-info{flex:1}.log-desc{font-size:28rpx;display:block}.log-time{font-size:22rpx;color:#aaa;margin-top:6rpx}.log-amount{font-size:32rpx;font-weight:700}.positive{color:#10B981}.negative{color:#EF4444}.loading-wrap{text-align:center;padding:80rpx;color:#999}.empty-state{text-align:center;padding:80rpx;color:#999}