.page{min-height:100vh;background:#F5F5F7}.reward-list{padding:20rpx 30rpx}.reward-card{background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:20rpx;display:flex;gap:20rpx}.reward-img{width:140rpx;height:140rpx;border-radius:16rpx;background:#f0f0f0;flex-shrink:0}.reward-info{flex:1;display:flex;flex-direction:column}.reward-name{font-size:30rpx;font-weight:600}.reward-desc{font-size:24rpx;color:#999;margin-top:6rpx;flex:1}.reward-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:12rpx}.reward-points{font-size:26rpx;color:#4F46E5;font-weight:600}.claim-btn{background:linear-gradient(135deg,#4F46E5,#7C3AED);color:#fff;border-radius:10rpx;padding:10rpx 28rpx;font-size:24rpx;border:none}.claim-btn::after{border:none}.loading-wrap{text-align:center;padding:80rpx;color:#999}