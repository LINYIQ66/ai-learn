.page{min-height:100vh;background:#F5F5F7;padding:30rpx}.content{padding-bottom:40rpx}.quiz-item{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}.question{font-size:30rpx;font-weight:600;margin-bottom:20rpx;color:#1a1a2e}.option{padding:18rpx 20rpx;margin-bottom:12rpx;background:#F8F9FA;border-radius:10rpx;font-size:28rpx;display:flex;align-items:center;gap:16rpx;border:2rpx solid transparent}.option.selected{background:#EEF2FF;border-color:#4F46E5}.option.correct{background:#ECFDF5;border-color:#10B981}.label{width:40rpx;height:40rpx;border-radius:50%;background:#E2E8F0;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:600;flex-shrink:0}.result{text-align:center;padding:40rpx 0}.score{font-size:48rpx;font-weight:700;color:#4F46E5;margin-bottom:10rpx}.detail{font-size:26rpx;color:#666;margin-bottom:30rpx}.btn-primary{background:linear-gradient(135deg,#4F46E5,#7C3AED);color:#fff;border-radius:14rpx;padding:24rpx;font-size:30rpx;text-align:center;border:none}.btn-primary::after{border:none}.btn-outline{background:#fff;color:#4F46E5;border:2rpx solid #4F46E5;border-radius:14rpx;padding:20rpx;font-size:28rpx;text-align:center;margin-top:20rpx}.btn-outline::after{border:none}.loading-wrap{text-align:center;padding:80rpx;color:#999}.empty-state{text-align:center;padding:80rpx;color:#999}