.page{min-height:100vh;background:#fff}.msg-item{display:flex;align-items:center;gap:20rpx;padding:28rpx 30rpx;border-bottom:1rpx solid #f5f5f7}.msg-avatar{width:96rpx;height:96rpx;border-radius:50%;background:#f0f0f0;flex-shrink:0}.msg-info{flex:1;min-width:0}.msg-header{display:flex;justify-content:space-between;margin-bottom:8rpx}.msg-name{font-size:30rpx;font-weight:600}.msg-time{font-size:22rpx;color:#bbb}.msg-content{font-size:26rpx;color:#999;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.unread-dot{width:16rpx;height:16rpx;border-radius:50%;background:#EF4444;flex-shrink:0}.loading-wrap{text-align:center;padding:80rpx;color:#999}.empty-state{text-align:center;padding:80rpx}